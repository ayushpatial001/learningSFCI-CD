<apex:page standardController="Account">
    <apex:form >
        <apex:pageBlock title="New Account Information">
            <apex:pageBlockSection id="account-details" title="Account Details">
                <apex:inputField value="{!Account.Name}"/>
                <apex:inputField value="{!Account.AccountNumber}"/>
                <apex:inputField value="{!Account.Email__c}"/>
                <apex:inputField value="{!Account.Phone}"/>
                <apex:inputField value="{!Account.Industry}"/>
                <apex:inputField value="{!Account.Active__c}"/>
            </apex:pageBlockSection>
            
            <apex:pageBlockSection id="account-address-details" columns="2">
                <apex:pageBlockSection id="billing-address-details" title="Account Billing Address Details" columns="1">
                    <apex:inputField value="{!Account.BillingStreet}" />
                    <apex:inputField value="{!Account.BillingCity}" />
                    <apex:inputField value="{!Account.BillingState}" />
                    <apex:inputField value="{!Account.BillingPostalCode}" />
                    <apex:inputField value="{!Account.BillingCountry}" />          
                </apex:pageBlockSection>
                
                <apex:pageBlockSection id="shipping-address-details" title="Account Shipping Address Details" columns="1">
                    <apex:inputField value="{!Account.ShippingStreet}" />
                    <apex:inputField value="{!Account.ShippingCity}" />
                    <apex:inputField value="{!Account.ShippingState}" />
                    <apex:inputField value="{!Account.ShippingPostalCode}" />
                    <apex:inputField value="{!Account.ShippingCountry}" />                                      
                </apex:pageBlockSection>
            </apex:pageBlockSection>
            
            <center>
                <apex:commandButton action="{!save}" value="Save"/>
                <apex:commandButton action="{!cancel}" value="Cancel"/>
            </center>
            
        </apex:pageBlock>
    </apex:form>
</apex:page>