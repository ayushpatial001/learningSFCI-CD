<apex:page standardController="Employee__c" >
    <apex:form >
        <apex:pageBlock title="Create Employee Record">
            <apex:pageBlockSection columns="2" title="Personal Detail" >
                <apex:inputField value="{!Employee__c.Name}" required="true"></apex:inputField>
                <apex:inputField value="{!Employee__c.Date_of_Birth__c}" required="true"></apex:inputField>
                <apex:inputField value="{!Employee__c.Aadhar_Number__c}"></apex:inputField>
                <apex:inputField value="{!Employee__c.Email_Address__c}" required="True" ></apex:inputField>
                <apex:inputField value="{!Employee__c.Joining_Date__c}"  required="True" ></apex:inputField>
                <apex:inputField value="{!Employee__c.Primary_Number__c}" required="True" ></apex:inputField>  
                <apex:inputField value="{!Employee__c.Mother_s_Name__c}"></apex:inputField>       
                <apex:inputField value="{!Employee__c.Father_s_Name__c}"></apex:inputField> 
                <apex:inputField value="{!Employee__c.Gender__c}"></apex:inputField> 
                <apex:inputField value="{!Employee__c.Active__c}"></apex:inputField>
            </apex:pageBlockSection> 
            <apex:pageBlockSection columns="2" title="Certification Detail">
                <apex:inputField value="{!Employee__c.Salesforce_Experience__c}"></apex:inputField>
                <apex:inputField value="{!Employee__c.Salesforce_Experience_In_years__c}"></apex:inputField>
                <apex:inputField value="{!Employee__c.Certification__c}"></apex:inputField>
                <apex:inputField value="{!Employee__c.Name_of_the_Certification__c}"></apex:inputField>
               
            </apex:pageBlockSection>
            <apex:pageBlockSection columns="2" title="Bank Details">
                <apex:inputField value="{!Employee__c.Bank_Name__c}"></apex:inputField>
                <apex:inputField value="{!Employee__c.Bank_Branch_Name__c}"></apex:inputField>
                <apex:inputField value="{!Employee__c.Bank_Account_Number__c}"></apex:inputField>
                <apex:inputField value="{!Employee__c.IFSC_Code__c}"></apex:inputField>     
            </apex:pageBlockSection>
            <div style="text-align: center;">
                <apex:commandButton action="{!save}" value="Save"></apex:commandButton>
                <span>      </span>
                <apex:commandButton action="{!Cancel}" value="Cancel"></apex:commandButton>
            </div>
        </apex:pageBlock>    
    </apex:form>
</apex:page>